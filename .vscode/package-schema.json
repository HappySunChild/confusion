{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "confusion-package",
    "type": "object",
    "required": [
        "name",
        "author",
        "repository",
        "modules"
    ],
    "properties": {
        "name": {
            "type": "string"
        },
        "description": {
            "type": "string"
        },
        "author": {
            "type": "string"
        },
        "repository": {
            "type": "string"
        },
        "modules": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    }
}
{
    "$schema": "../../.vscode/module-schema.json",
    "name": "Core: Graph",
    "description": "Provides internal utilities for working with Confusion's reactive dependency graph.",
    "author": "HappySunChild (Eli)",
    "dependencies": [
        "core_memory",
        "core_logging",
        "core_external"
    ],
    "export_types": {
        "GraphNode": {
            "internal_name": "GraphNode"
        }
    },
    "export_members": {
        "observe": {
            "source": "observe.luau",
            "type": "core_graph.Observe"
        },
        "observe_immediate": {
            "source": "observe_immediate.luau",
            "type": "core_graph.Observe"
        }
    }
}
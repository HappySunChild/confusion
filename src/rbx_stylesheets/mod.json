        },
        {
            "export_name": "StyleRuleProperties",
            "source": "keys/StyleRuleProperties.luau",
            "type": "rbx_instances.SpecialKey<\"StyleRuleProperties\">"
        },
        {
            "export_name": "StyleRuleTransitions",
            "source": "keys/StyleRuleTransitions.luau",
            "type": "rbx_instances.SpecialKey<\"StyleRuleTransitions\">"
        },
        {
            "export_name": "StyleLink",
            "source": "keys/StyleLink.luau",
            "type": "rbx_instances.SpecialKey<\"StyleLink\">"
        },
        {
            "export_name": "StyleRules",
            "source": "keys/StyleRules.luau",
            "type": "rbx_instances.SpecialKey<\"StyleRules\">"
        }
    ]
}
{
    "$schema": "../../.vscode/module-schema.json",
    "label": "Roblox: Stylesheets",
    "description": "Provides utilities for creating StyleSheets and binding properties to state.",
    "runtime": "rbx",
    "requires": [
        "core_graph",
        "core_memory",
        "core_state",
        "rbx_instances"
    ],
    "export_types": [],
    "export_members": [
        {
            "export_name": "StyleSheet",
            "source": "StyleSheet.luau",
            "type": "rbx_stylesheets.StyleSheetConstructor"
        },
        {
            "export_name": "StyleRule",
            "source": "StyleRule.luau",
            "type": "rbx_stylesheets.StyleRuleConstructor"
        },
        {
            "export_name": "StyleSheetDerives",
            "source": "keys/StyleSheetDerives.luau",

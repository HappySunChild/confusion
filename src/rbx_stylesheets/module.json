{
    "$schema": "../../.vscode/module-schema.json",
    "name": "Roblox: Stylesheets",
    "category": "instances",
    "description": "Provides utilities for creating and managing Roblox StyleSheets with reactive property bindings.",
    "runtime": "roblox",
    "author": "HappySunChild (Eli)",
    "dependencies": [
        "core_graph",
        "core_memory",
        "core_state",
        "rbx_instances"
    ],
    "export_types": {},
    "export_members": {
        "StyleSheet": {
            "source": "StyleSheet.luau",
            "type": "rbx_stylesheets.StyleSheetConstructor"
        },
        "StyleRule": {
            "source": "StyleRule.luau",
            "type": "rbx_stylesheets.StyleRuleConstructor"
        },
        "StyleSheetDerives": {
            "source": "keys/StyleSheetDerives.luau",
            "type": "rbx_instances.SpecialKey<\"StyleSheetDerives\">"
        },
        "StyleRuleProperties": {
            "source": "keys/StyleRuleProperties.luau",
            "type": "rbx_instances.SpecialKey<\"StyleRuleProperties\">"
        },
        "StyleRuleTransitions": {
            "source": "keys/StyleRuleTransitions.luau",
            "type": "rbx_instances.SpecialKey<\"StyleRuleTransitions\">"
        },
        "StyleLink": {
            "source": "keys/StyleLink.luau",
            "type": "rbx_instances.SpecialKey<\"StyleLink\">"
        },
        "StyleRules": {
            "source": "keys/StyleRules.luau",
            "type": "rbx_instances.SpecialKey<\"StyleRules\">"
        }
    }
}
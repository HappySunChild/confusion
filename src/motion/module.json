{
    "$schema": "../../.vscode/module-schema.json",
    "name": "Motion",
    "category": "animation",
    "description": "Provides a reactive motion primitive for animating values over time.",
    "author": "HappySunChild (Eli)",
    "dependencies": [
        "core_external",
        "core_graph",
        "core_logging",
        "core_memory",
        "core_state",

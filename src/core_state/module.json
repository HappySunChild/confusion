{
    "$schema": "../../.vscode/module-schema.json",
    "name": "Core: State",
    "description": "Provides core reactive primitives and internal state management utilities.",
    "author": "HappySunChild (Eli)",
    "dependencies": [
        "core_external",
        "core_graph",
        "core_logging",
        "core_memory"
    ],
    "export_types": {
        "StateNode<T>": {
            "internal_name": "StateNode<T>"
        },
        "UsedAs<T>": {
            "internal_name": "UsedAs<T>"
        },
        "Value<T>": {
            "internal_name": "Value<T>"
        },
        "Computed<T>": {
            "internal_name": "Computed<T>"
        },
        "Use": {
            "internal_name": "Use"
        }
    },
    "export_members": {
        "Computed": {
            "source": "Computed.luau",
            "type": "core_state.ComputedConstructor"
        },
        "Value": {
            "source": "Value.luau",
            "type": "core_state.ValueConstructor"
        },
        "peek": {
            "source": "peek.luau",
            "type": "core_state.Use"
        },
        "flatten": {
            "source": "flatten.luau",
            "type": "core_state.Flatten"
        }
    }
}
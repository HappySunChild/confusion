{
    "$schema": "../../.vscode/module-schema.json",
    "name": "Roblox: Instances",
    "category": "instances",
    "description": "Provides utilities for creating Roblox Instances and binding properties to reactive state.",
    "runtime": "roblox",
    "author": "HappySunChild (Eli)",
    "dependencies": [
        "core_external",
        "core_graph",
        "core_logging",
        "core_memory",
        "core_state"
    ],
    "export_types": {
        "SpecialKey<T = string>": {
            "internal_name": "SpecialKey<T>"
        },
        "Child": {
            "internal_name": "Child"
        }
    },
    "export_members": {
        "New": {
            "source": "New.luau",
            "type": "rbx_instances.NewConstructor"
        },
        "Hydrate": {
            "source": "Hydrate.luau",
            "type": "rbx_instances.HydrateConstructor"
        },
        "AttributeChange": {
            "source": "keys/AttributeChange.luau",
            "type": "(attribute: string) -> rbx_instances.SpecialKey<\"AttributeChange\">"
        },
        "AttributeOut": {
            "source": "keys/AttributeOut.luau",
            "type": "(attribute: string) -> rbx_instances.SpecialKey<\"AttributeOut\">"
        },
        "Attributes": {
            "source": "keys/Attributes.luau",
            "type": "rbx_instances.SpecialKey<\"Attributes\">"
        },
        "Children": {
            "source": "keys/Children.luau",
            "type": "rbx_instances.SpecialKey<\"Children\">"
        },
        "OnChange": {
            "source": "keys/OnChange.luau",
            "type": "(property: string) -> rbx_instances.SpecialKey<\"OnChange\">"
        },
        "OnEvent": {
            "source": "keys/OnEvent.luau",
            "type": "(event: string) -> rbx_instances.SpecialKey<\"OnEvent\">"
        },
        "Out": {
            "source": "keys/Out.luau",
            "type": "(property: string) -> rbx_instances.SpecialKey<\"Out\">"
        },
        "Refs": {
            "source": "keys/Refs.luau",
            "type": "rbx_instances.SpecialKey<\"Refs\">"
        },
        "Tags": {
            "source": "keys/Tags.luau",
            "type": "rbx_instances.SpecialKey<\"Tags\">"
        }
    }
}
{
    "$schema": "../../.vscode/module-schema.json",
    "label": "Motion: Tweens",
    "category": "animation",
    "description": "Provides a convenience constructor for creating tween-driven motion with configurable timing and easing.",
    "requires": [
        "core_memory",
        "core_state",
        "lerp",
        "motion"
    ],
    "export_types": [
        {
            "export_name": "TweenInfo",
            "name": "TweenInfo"
        }
    ],
    "export_members": [
        {
            "export_name": "Tween",
            "source": "Tween.luau",
            "type": "motion_tweens.TweenConstructor"
        },
        {
            "export_name": "TweenInfo",
            "source": "TweenInfo.luau",
            "type": "motion_tweens.TweenInfoConstructor"
        },
        {
            "export_name": "easing_styles",
            "source": "easing_styles.luau",
            "type": "motion_tweens.EasingStyles"
        }
    ],
    "external_consumers": [
        "scheduler"
    ]
}
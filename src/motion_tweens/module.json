{
    "$schema": "../../.vscode/module-schema.json",
    "name": "Motion: Tweens",
    "description": "Provides a convenience constructor for creating tween-driven motion with configurable timing and easing.",
    "author": "HappySunChild (Eli)",
    "dependencies": [
        "core_memory",
        "core_state",
        "lerp",
        "motion"
    ],
    "export_types": {
        "TweenInfo": {
            "internal_name": "TweenInfo"
        },
        "EasingDirection": {
            "internal_name": "EasingDirection"
        }
    },
    "export_members": {
        "Tween": {
            "source": "Tween.luau",
            "type": "motion_tweens.TweenConstructor"
        },
        "TweenInfo": {
            "source": "TweenInfo.luau",
            "type": "motion_tweens.TweenInfoConstructor"
        },
        "easing_styles": {
            "source": "easing_styles.luau",
            "type": "motion_tweens.EasingStyles"
        },
        "differential_easing_styles": {
            "source": "differential_easing_styles.luau",
            "type": "motion_tweens.DifferentialEasingStyles"
        }
    },
    "external_consumers": [
        "scheduler"
    ]
}
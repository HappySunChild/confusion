{
    "$schema": "../../.vscode/module-schema.json",
    "name": "Core: Memory",
    "description": "Provides utilities for managing the lifecycle of garbage-collected resources.",
    "author": "HappySunChild (Eli)",
    "dependencies": [
        "core_external"
    ],
    "export_types": {
        "Scope<T = Confusion>": {
            "internal_name": "Scope<T>"
        }
    },
    "export_members": {
        "scoped": {
            "source": "scoped.luau",
            "type": "core_memory.Scoped"
        },
        "derive_scope": {
            "source": "derive_scope.luau",
            "type": "core_memory.Scoped"
        },
        "inner_scope": {
            "source": "inner_scope.luau",
            "type": "core_memory.Scoped"
        },
        "cleanup": {
            "source": "cleanup.luau",
            "type": "core_memory.Cleanup"
        },
        "insert": {
            "source": "insert.luau",
            "type": "core_memory.Insert"
        }
    }
}
{
	"name": "confusion-rbx-testing",
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"$ignoreUnknownInstances": true,
			"confusion": {
				"$path": "rojo/confusion"
			}
		},
		"ServerScriptService": {
			"$ignoreUnknownInstances": true,
			"$className": "ServerScriptService",
			"devtests": {
				"$className": "Folder",
				"$ignoreUnknownInstances": true,
				"confusion": {
					"$path": "rojo/_server"
				}
			}
		},
		"StarterPlayer": {
			"$ignoreUnknownInstances": true,
			"$className": "StarterPlayer",
			"StarterPlayerScripts": {
				"$className": "StarterPlayerScripts",
				"$ignoreUnknownInstances": true,
				"devtests": {
					"$className": "Folder",
					"$ignoreUnknownInstances": true,
					"confusion": {
						"$path": "rojo/_client"
					}
				}
			}
		}
	},
	"globIgnorePaths": [
		"**/module.json"
	]
}